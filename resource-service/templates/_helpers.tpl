{{/*
Current date, generated by Helm at render time (YYYY-MM-DD).
*/}}
{{- define "resources-ms.currentDate" -}}
{{ now | date "2006-01-02" }}
{{- end }}

{{/*
Chart/application version.
*/}}
{{- define "resources-ms.version" -}}
{{ .Chart.AppVersion }}
{{- end }}

{{/*
Common labels: current date and version.
*/}}
{{- define "resources-ms.labels" -}}
current-date: {{ include "resources-ms.currentDate" . | quote }}
version: {{ include "resources-ms.version" . | quote }}
{{- end }}

{{/*
Name of the Secret with DB credentials (existing one or the chart-managed one).
*/}}
{{- define "resources-ms.secretName" -}}
{{ default "resources-db-secret" .Values.secret.existingSecret }}
{{- end }}
