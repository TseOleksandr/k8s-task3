{{/*
Current date, generated by Helm at render time (YYYY-MM-DD).
*/}}
{{- define "songs-ms.currentDate" -}}
{{ now | date "2006-01-02" }}
{{- end }}

{{/*
Chart/application version.
*/}}
{{- define "songs-ms.version" -}}
{{ .Chart.AppVersion }}
{{- end }}

{{/*
Common labels: current date and version.
*/}}
{{- define "songs-ms.labels" -}}
current-date: {{ include "songs-ms.currentDate" . | quote }}
version: {{ include "songs-ms.version" . | quote }}
{{- end }}

{{/*
Name of the Secret with DB credentials (existing one or the chart-managed one).
*/}}
{{- define "songs-ms.secretName" -}}
{{ default "songs-db-secret" .Values.secret.existingSecret }}
{{- end }}
